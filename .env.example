# Turso (libSQL) connection — for local dev you can use a local SQLite file instead:
# TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin dashboard password (never expose client-side)
ADMIN_PASSWORD=0915

# Random secret used to sign the admin session cookie (any long random string)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
