# Database: Cloudflare D1, configured via the d1_databases binding in
# wrangler.jsonc (binding name "DB"). No connection env vars needed —
# `next dev` gets a local D1 emulation automatically via
# initOpenNextCloudflareForDev() in next.config.ts.

# Admin dashboard password (never expose client-side)
ADMIN_PASSWORD=0915

# Random secret used to sign the admin session cookie (any long random string)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
